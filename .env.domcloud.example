[TEMPLATE DOM CLOUD — NE CONTIENT AUCUN SECRET]
# Copier ce fichier en `.env` SUR LE SERVEUR uniquement (jamais dans Git).
#   cp .env.domcloud.example .env
#   php artisan key:generate
# Les variables d'environnement réelles du serveur restent prioritaires sur ce fichier.

APP_NAME="Prono IA"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Remplacer par l'URL réelle du site Laravel (https).
APP_URL=https://<domaine-laravel>

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# ─── Base MariaDB fournie par DOM Cloud ──────────────────────────────────────
# Les identifiants exacts sont dans Manage → Database du site.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<utilisateur>_db
DB_USERNAME=<utilisateur>
DB_PASSWORD=

# ─── Microservice FastAPI (site séparé sur DOM Cloud) ────────────────────────
# Jamais localhost:8001 en production : c'est l'URL publique du site FastAPI.
AI_SERVICE_URL=https://<domaine-fastapi>
AI_SERVICE_SECRET=

# ─── Fournisseurs (pare-feu sortant) ─────────────────────────────────────────
# Sur le forfait gratuit, seuls les domaines de la liste blanche DOM Cloud sont
# joignables. Voir deployment/domcloud/README.md : football-data.org,
# API-Football et The Odds API ne sont PAS dans cette liste tant qu'elle n'est
# pas étendue ; Gemini (generativelanguage.googleapis.com) l'est déjà.
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_COMPETITIONS=PL,PD,BL1,SA,FL1,CL
FOOTBALL_DATA_DISCOVER_INTERNATIONAL=false
FOOTBALL_DATA_CATALOG_CACHE_MINUTES=1440

API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_COMPETITIONS=6
API_FOOTBALL_SEASONS=
API_FOOTBALL_DISCOVER=true
API_FOOTBALL_MAX_COMPETITIONS=12
API_FOOTBALL_MAX_PAGES=2
API_FOOTBALL_DAYS_AHEAD=14
API_FOOTBALL_DAILY_CALL_LIMIT=100
API_FOOTBALL_CATALOG_CACHE_MINUTES=1440

THE_ODDS_API_KEY=
THE_ODDS_API_MARKETS=h2h,totals,spreads
THE_ODDS_API_EVENT_MARKETS=btts,team_totals,double_chance
THE_ODDS_API_EVENT_MARKET_MAX_EVENTS=8

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PREDICTION_HYBRID_MODE=ASSISTED
PREDICTION_ALLOW_AI_IN_PARLAYS=true
PREDICTION_BOOTSTRAP_REPLICATES=0
PREDICTION_BOOTSTRAP_MIN_OBSERVATIONS=20
PREDICTION_ALLOW_LIMITED_DATA_PREDICTIONS=true

# Jeton exigé par les routes API mutantes.
API_TOKEN=

# ─── Exécution ───────────────────────────────────────────────────────────────
# Pas de processus détaché sur le forfait gratuit : `schedule:run` exécute
# chaque tâche dans son propre processus.
SCHEDULER_RUN_IN_BACKGROUND=false

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
