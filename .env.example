APP_NAME="Prono IA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_SECRET=your-internal-service-secret-token

FOOTBALL_DATA_API_KEY=your-football-data-org-token
FOOTBALL_DATA_COMPETITIONS=PL,PD,BL1,SA,FL1,CL
# Découverte optionnelle des compétitions internationales réellement renvoyées par /competitions.
FOOTBALL_DATA_DISCOVER_INTERNATIONAL=false
FOOTBALL_DATA_CATALOG_CACHE_MINUTES=1440
FOOTBALL_DATA_INTERNATIONAL_KEYWORDS="world cup,euro,uefa nations league,copa america,africa cup of nations,afcon,world cup qualifiers,euro qualifiers,africa cup qualifiers,international friendly"
API_FOOTBALL_KEY=your-api-football-key
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# 6 = Africa Cup of Nations. Ajouter 36/29 uniquement si le compte les couvre.
API_FOOTBALL_COMPETITIONS=6
# Vide = année courante + année précédente (certaines compétitions nomment
# leur saison par leur année de départ).
API_FOOTBALL_SEASONS=
# Découverte du catalogue réellement accessible, priorité aux compétitions
# ci-dessus puis aux compétitions complémentaires trouvées chez le fournisseur.
API_FOOTBALL_DISCOVER=true
API_FOOTBALL_MAX_COMPETITIONS=12
API_FOOTBALL_MAX_PAGES=2
API_FOOTBALL_DAYS_AHEAD=14
API_FOOTBALL_DAILY_CALL_LIMIT=100
API_FOOTBALL_CATALOG_CACHE_MINUTES=1440
# Filtres optionnels (vide = tout le catalogue du fournisseur).
API_FOOTBALL_COUNTRIES=
API_FOOTBALL_TYPES=league,cup
API_FOOTBALL_EXCLUDE_COMPETITIONS=
THE_ODDS_API_KEY=your-odds-api-key
THE_ODDS_API_MARKETS=h2h,totals,spreads

# Assistant IA (Google Gemini - Section 9)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
PREDICTION_HYBRID_MODE=ASSISTED
PREDICTION_ALLOW_AI_IN_PARLAYS=true
PREDICTION_BOOTSTRAP_REPLICATES=0
PREDICTION_BOOTSTRAP_MIN_OBSERVATIONS=20
# Phase de test : les données limitées dégradent la confiance sans bloquer la
# prédiction. Passer à false pour restaurer l'abstention automatique.
PREDICTION_ALLOW_LIMITED_DATA_PREDICTIONS=true

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
